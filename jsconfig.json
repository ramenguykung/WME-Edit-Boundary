{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["wme-sdk-typings"],
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["walker.user.script.js", "types/**/*.d.ts"],
  "exclude": ["node_modules", "tests"]
}
